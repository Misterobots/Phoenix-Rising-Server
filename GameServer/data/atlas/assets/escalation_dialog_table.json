   "type": "DataTable",
   "props": {
    "RowStruct": "Class DialogTableRow",
    "Rows": {
     "ESC_QUEST_01_INTRO": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_01",
        "Subtitle": "Remember why we're here. To hunt Behemoths, sure. Always. But we also need to bring back some of that charged aether for Old Arkan to study.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_QUEST_01_INTRO": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_01",
        "Subtitle": "Skyslayer, you hunt where few of your kind ever have--the ice fields of Skaldeskar, my home. You are welcome to slay the Behemoths and gather the charged aether you find here. Just make sure you keep yourself warm. The frost? It bites.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_QUEST_02_INTRO": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_02",
        "Subtitle": "If the ship's instruments are correct, there's a pretty powerful Behemoth at the top of this food chain. Pace yourself and build up your strength. When you reach the end of these islands I think you're going to need every advantage you can get.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_QUEST_02_INTRO": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_02",
        "Subtitle": "Steel yourself, Skyslayer, and may the snowblood protect you. My scouts report the Urska has stirred from its cold slumber. But to reach the adversary, you'll have to fight your way there--and make enough racket to wake the dead. Or at least to wake the hibernating.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_GENERIC_INTRO": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_03",
        "Subtitle": "Something tells me you won't have to look far for your quarry. Good luck down there, captain.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_04",
        "Subtitle": "We've got to extract that charged aether from the lodestone before those Behemoths do. Don't let Old Arkan down.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_05",
        "Subtitle": "These skies are playing hell with the ship's stabilizers. We need to fall back now, but we'll be there to pick you up at the top of the chain.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_06",
        "Subtitle": "Focus on those Behemoths and the power they're feeding on. We need that energy back in Ramsgate... and we don't need any more hypercharged Behemoths in the mix. ",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_07",
        "Subtitle": "Never flown this close to the Maelstrom's heart before. Can't say I'm a fan. We'll be back to pick you up when you reach the top, skipper.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_GENERIC_INTRO": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_03",
        "Subtitle": "It's a cold one out there today, Skyslayer. What am I saying? It's always a cold one out there by your standards. So stay warm, stay alert, and stay alive. You have work to do. ",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_04",
        "Subtitle": "You need some charged aether to take back with you to Ramsgate. And watch out. Frostbite can set in faster than you think.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_05",
        "Subtitle": "Only fools charge into Skaldeskar unprepared. The cold is bitter, but there are ways to keep your Skyslayer blood from freezing. Watch for the fires.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_06",
        "Subtitle": "Skaldeskar is seething with charged aether, built up over centuries as layer upon layer of ice and frost settled across these isles. Take as much as you can. You'll be doing us a favour.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_07",
        "Subtitle": "There's a long and icy path laid before you, Skyslayer. But you are helping my home, so I will help you with what boons I can offer during your hunt. Keep in touch.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_TUT_GATHER_CRYSTAL": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_17",
        "Subtitle": "Can you see that, cap? Scanners are reading energy spikes from that Behemoth are overloading that lodestone--it must be quite a light show. Use your lantern to drain and store the charged aether.",
        "SubtitleDuration": 6.5,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_TUT_GATHER_CRYSTAL": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_17",
        "Subtitle": "The charged aether is spiking! It's been trapped in a lodestone, so you'll need to extract it with your lantern. You can see the power trapped within!",
        "SubtitleDuration": 6.5,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_TUT_SELECT_BUFF": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_18",
        "Subtitle": "Your lantern can't hold all of that energy, but burning off the excess can grant you some short-term benefits, or so Arkan was saying. You just need to choose.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_TUT_SELECT_BUFF": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_18",
        "Subtitle": "Charged aether is certainly unpredictable. It can even provide surprising help when you least expect it.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_TUT_JUMP_VENT": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_19",
        "Subtitle": "You've done all you can here. Now ride the wave on up the ladder, cap.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_TUT_JUMP_VENT": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_19",
        "Subtitle": "Your work here is done, Skyslayer. Ride the aether winds to your next battle when you're ready.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_TUT_MOD_INTRO": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_42",
        "Subtitle": "The Maelstrom's storm surges are interacting with the lodestone cores of these islands in unpredictable ways. Things may not go as you expect, so be cautious.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_TUT_MOD_INTRO": {
      "Entries": [
       {
        "AudioEvent": null,
        "Subtitle": null,
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_TUT_DUAL_BEH_INTRO": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_44",
        "Subtitle": "You've got company. Detecting at least two Behemoths at your position, cap.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_TUT_DUAL_BEH_INTRO": {
      "Entries": [
       {
        "AudioEvent": null,
        "Subtitle": null,
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_ROUND_COMPLETE_GENERIC_01": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_08",
        "Subtitle": "Good work. That's one less Behemoth to deal with. But I doubt it'll be your last.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_09",
        "Subtitle": "Another Behemoth bites the dust. You do fine work, captain. Now get ready for that aether burst.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_10",
        "Subtitle": "You earned your pay on that one, skipper. One more Behemoth down.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_11",
        "Subtitle": "That's one Behemoth that won't prey on these islands again. And its energies will only help you in the next battle.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_12",
        "Subtitle": "You're pretty good at this, cap. That Behemoth has snarled its last.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_ROUND_COMPLETE_GENERIC_01": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_08",
        "Subtitle": "Behemoth down! Not bad for a Skyslayer. Now gather your charged aether--there's much more to do.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_09",
        "Subtitle": "Good to know the Frostwardens have allies like you. Now take what you need from the aether burst, and quickly.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_10",
        "Subtitle": "Your prowess is proving quite impressive. Are all Skyslayers this good? I supposed there's only one way to find out. On to the next battle!",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_11",
        "Subtitle": "That Behemoth won't menace my people any longer. I'm grateful, Skyslayer, but the fight's not over yet. As soon as you have the charged aether you seek, you must move on.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_12",
        "Subtitle": "You fight with the courage of a Frostwarden, Skyslayer, and have the battle prowess to match. Another threat to Skaldeskar defeated!",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_13",
        "Subtitle": "It's finished, Skyslayer. The Behemoth has fallen! A mighty victory indeed.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_14",
        "Subtitle": "The Behemoth has fallen, Skyslayer. You have struck another blow for Skaldeskar.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_15",
        "Subtitle": "This is how we will take back Skaldeskar. Without fear, and with victory burning in our hearts.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_16",
        "Subtitle": "You Skyslayers might just know what you're doing after all, I have to admit.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_FINAL_ARENA_EASY_MODE": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_20",
        "Subtitle": "Looks like we've got no more Behemoths on the scanner beyond this island. This is your final battle... this time.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_21",
        "Subtitle": "You've reached the end of the chain, cap. Looks like this is as bad as it's gonna get.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_FINAL_ARENA_EASY_MODE": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_21",
        "Subtitle": "I think this as bad as it's going to get, Skyslayer. But don't expect these Behemoths to go easy on you. Behemoths don't do that.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_22",
        "Subtitle": "The Urska still slumbers, so this will be your final battle. This time.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_FINAL_ARENA_THUNDERBIRD_INTRO": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_23",
        "Subtitle": "There! That's the Behemoth at the top of the food chain. The one feeding on the most concentrated deposits. That beast is sitting between you and the motherlode. ",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_FINAL_ARENA_THUNDERBIRD_INTRO": {
      "Entries": [
       {
        "AudioEvent": null,
        "Subtitle": null,
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_FINAL_ARENA_MINT_INTRO": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_23",
        "Subtitle": "Skyslayer, you are about to face a beast my people consider a living legend. The Urska has dwelled deep within the heart of Skaldeskar's ice caverns for as long as we can remember, and my most sacred duty as queen is to see its end. Unfortunately, it never seems to stay dead. Perhaps this will be its final fight.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_FINAL_ARENA_THUNDERBIRD_REPEAT": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_24",
        "Subtitle": "We can't let that beast continue to feed on this island. You know what to do, cap.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_25",
        "Subtitle": "There it is. The nastiest Behemoth in this island cluster. Take it down with extreme prejudice.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_26",
        "Subtitle": "Are you seeing what I'm seeing, skipper? That Behemoth looks like one mean piece of work. But it's the worst of the lot, too.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_FINAL_ARENA_THUNDERBIRD_REPEAT": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_24",
        "Subtitle": "I'll bet you didn't think these islands could get any colder. But that's what the Urska does, Skyslayer. How about adding a little heat?",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_25",
        "Subtitle": "The Frostshapers say the Urska dwells within the ice itself, and that's why it never seems to stay dead. But there has to be a first time, eh Skyslayer? Make this one count.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_26",
        "Subtitle": "You're in the domain of the Urska now, Skyslayer. I challenge you to drive our adversary back into the ice.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_EOH_SUCCESS_EASY_MODE": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_39",
        "Subtitle": "Looks like that's the worst of it. But more charged aether for us, eh?",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_40",
        "Subtitle": "The keystone island should be packed with charged aether now that you've taken down the last Behemoth. Nice work.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_41",
        "Subtitle": "And that's a victory, skipper! Nothing else turning up on the scanners. Let's get that charged aether and get out.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_EOH_SUCCESS_EASY_MODE": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_42",
        "Subtitle": "There are no more Behemoths in your way, Skyslayer. Your bosun recommends you make ready to depart, but I suspect we will see you in Skaldeskar again.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_43",
        "Subtitle": "Both Vylmark and Ramsgate can breathe easier. My home is safe--safer, at least--and the charged aether you've found will power your city for some time. It's time to go.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_44",
        "Subtitle": "That's a victory, Skyslayer. Frostwarden scouts tell me the way is clear again, and your bosun says the ship can't hold much more charged aether. Headed to your position now. ",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_EOH_SUCCESS_HARD_MODE": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_39",
        "Subtitle": "You have slain the Urska and won the gratitude of all Skaldeskar--and the profound respect of their queen. The charged aether is yours, of course.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_40",
        "Subtitle": "The Urska has been defeated! Perhaps it will return. It always seems to find a way. But the Frostwardens--and perhaps our new allies--will be ready.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_41",
        "Subtitle": "To slay a legend is no mean feat, Skyslayer. I trust you have all the charged aether you sought and more. You will always be welcomed as a friend of the Skaldish.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_EOH_SUCCESS_HARD_MODE": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_36",
        "Subtitle": "You're the top of the heap now, skipper. A hard-earned victory. And to the victor go the spoils!",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_37",
        "Subtitle": "That's it! You did it. The Behemoth is down. I repeat, the Behemoth is down. And it's left behind the motherlode of motherlodes.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_38",
        "Subtitle": "You've beaten the keystone Behemoth! Never doubted you for a second, cap. Now get the charged aether that thing was guarding and we can get outta here.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_EOH_SUCCESS_NOT_MIN_LEVEL": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_33",
        "Subtitle": "Whatever was feeding on the keystone island cleared out before you arrived. I'm putting this one in the \"win\" column.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_34",
        "Subtitle": "Those Behemoths never saw you coming, skipper. You've cleared out the worst of them. Stand by for extraction.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_35",
        "Subtitle": "And it looks like that's a wrap. You've extracted all the charged aether you're going to get, and I'm not reading any more Behemoths in your vicinity.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_EOH_SUCCESS_NOT_MIN_LEVEL": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_36",
        "Subtitle": "My scouts report the Urska still slumbers within the ice, and won't emerge from its slumber anytime soon. Your work here is finished, Skyslayer.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_37",
        "Subtitle": "The Behemoths of Skaldeskar don't seem to like Skyslayers any more than they like Frostwardens. They have good taste in enemies.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_38",
        "Subtitle": "That's the end of trail, Skyslayer. The Urska has eluded us this time, but you've won the day against the beasts that imperiled my home. Well done.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_EOH_FAIL_DEFEATED": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_27",
        "Subtitle": "Are you reading me, skipper? We've got to extract you now or never.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_28",
        "Subtitle": "You can't do any more good down there. Let's get to safety and try again later.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_bosun_escalation_29",
        "Subtitle": "We're coming in to pull you out of there, cap. Stand by for extraction.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_SEASON_5_ESC_EOH_FAIL_DEFEATED": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_27",
        "Subtitle": "This isn't good. The Bosun's bringing the ship in for extraction.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_28",
        "Subtitle": "We lost this battle, but not the war. Your airship is inbound.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_escalation_29",
        "Subtitle": "This isn't defeat. This is a lesson not to underestimate our adversaries. The Bosun tells me you should stand by for pickup.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_FROST_BOON_MENDER": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_04",
        "Subtitle": "I'll do what I can to help you deal with the frostbite. Take shelter in the areas of warmth, Skyslayer. ",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_05",
        "Subtitle": "You have courage, but don't be a fool. Warm yourself against the frostbite near the safe areas before it's too late!",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_06",
        "Subtitle": "Look for zones of warmth to beat the frostbite. Skyslayers aren't made for this weather.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_FROST_BOON_WARRIOR": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_10",
        "Subtitle": "Take this boon. When you do great injury to your foes, your allies will grow stronger. ",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_11",
        "Subtitle": "I have a boon that makes Skyslayers more powerful, but only if you inspire them with your prowess in battle.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_12",
        "Subtitle": "This boon will galvanize your allies when you deal grievous harm to the enemy.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_FROST_BOON_DEFENDER": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_07",
        "Subtitle": "These spheres will offer you a little extra protection. Watch for them!",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_08",
        "Subtitle": "Protect yourself, Skyslayer, and make use of the spheres.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_09",
        "Subtitle": "You can use all the protection you can get. Keep an eye out for the spheres.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     },
     "ESC_FROST_BOON_SCOUT": {
      "Entries": [
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_01",
        "Subtitle": "Here to help, Skyslayer. I'll target their weak spots. You aim for my marks!",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_02",
        "Subtitle": "This Behemoth is vulnerable! Hit my mark, Skyslayer.",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       },
       {
        "AudioEvent": "AkAudioEvent Play_vo_frostwarden_leader_mod_boon_03",
        "Subtitle": "I've spotted a crack in its armour. Target my mark!",
        "SubtitleDuration": 5.0,
        "bAlwaysShowSubtitle": false,
        "Weight": 1.0
       }
      ]
     }
    }
   }
  }
 }
}